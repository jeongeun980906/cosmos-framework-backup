"""``action_policy_libero_nano`` — Cosmos3-Nano LIBERO 7D action-policy SFT recipe.

Mirrors ``action_policy_pusht_nano`` (same PackingDataLoader + optimizer/scheduler/
action-head stack), but feeds the four LIBERO eval suites (``libero_spatial``,
``libero_object``, ``libero_goal``, ``libero_10``) through
``ActionTransformPipeline`` and trains the generation + action heads from the
public ``nvidia/Cosmos3-Nano`` base.

LIBERO actions are 7D delta-EE ``[dpos(3), daxang(3), gripper]`` (single agent-view,
min-max normalized via the shared ``libero_lerobot_normalization.json``); the model
embeds/pads them to ``max_action_dim=64`` and masks padding via ``raw_action_dim``
(set automatically by the transform). The four suites are mixed at the dataloader
level with frame-count-proportional ratios — one policy trained on all four, as in
the Cosmos-Policy LIBERO setup.

Usage (1 node, N GPU)::

    LIBERO_ROOT=/path/to/LIBERO_LeRobot_v3 \\
    BASE_CHECKPOINT_PATH=<Cosmos3-Nano DCP dir> \\
    WAN_VAE_PATH=<Wan2.2_VAE.pth> \\
    torchrun --nproc_per_node=8 -m cosmos_framework.scripts.train \\
        --sft-toml examples/toml/sft_config/action_policy_libero_repro.toml
"""

import copy

from hydra.core.config_store import ConfigStore

from cosmos_framework.utils.lazy_config import LazyCall as L
from cosmos_framework.utils.lazy_config import LazyDict

from cosmos_framework.configs.base.experiment.sft.models.nano_model_config import NANO_MODEL_CONFIG
from cosmos_framework.data.vfm.joint_dataloader import (
    PackingDataLoader,
    RankPartitionedDataLoader,
)
from cosmos_framework.data.vfm.action.datasets.action_sft_dataset import get_action_libero_sft_dataset

cs = ConfigStore.instance()


# The four LIBERO eval suites are concatenated into ONE map-style dataset inside
# get_action_libero_sft_dataset (frame-count-proportional mixing). A single
# dataloader entry — unlike one-entry-per-suite — works for any world_size
# (RankPartitionedDataLoader requires #datasets <= #ranks). All share the same
# domain_id (libero=5) and the same combined normalization JSON.
_LIBERO_SUITES = ["libero_spatial", "libero_object", "libero_goal", "libero_10"]


action_policy_libero_nano = LazyDict(
    dict(
        defaults=[
            {"override /model": "mot_fsdp"},
            {"override /data_train": None},
            {"override /data_val": None},
            {"override /optimizer": "fusedadamw"},
            {"override /scheduler": "lambdalinear"},
            {"override /checkpoint": "s3"},
            {
                "override /callbacks": [
                    "basic",
                    "optimization",
                    "job_monitor",
                ]
            },
            {"override /ema": "power"},
            {"override /tokenizer": "wan2pt2_tokenizer"},
            {"override /sound_tokenizer": None},
            {"override /cluster": None},
            {"override /vlm_config": None},
            {"override /ckpt_type": "dcp"},
            "_self_",
        ],
        job=dict(
            project="cosmos3",
            group="action_sft",
            name="action_policy_libero_nano",
            wandb_mode="disabled",
        ),
        model=dict(
            config=copy.deepcopy(NANO_MODEL_CONFIG),  # action_gen=True, max_action_dim=64
        ),
        optimizer=dict(
            betas=[0.9, 0.99],
            eps=1.0e-08,
            fused=True,
            # Generation + action heads (mirrors action_policy_droid_nano).
            keys_to_select=[
                "moe_gen",
                "time_embedder",
                "vae2llm",
                "llm2vae",
                "action2llm",
                "llm2action",
                "action_modality_embed",
            ],
            lr=1.0e-04,  # lowered 2e-4 -> 1e-4 to stabilize the suite trade-off
            # (checkpoints oscillating which suite they're good at). 5x action ratio
            # preserved (action LR = 5e-4), so action adapters still catch up.
            lr_multipliers={
                "action2llm": 5.0,
                "llm2action": 5.0,
                "action_modality_embed": 5.0,
            },
            optimizer_type="FusedAdam",
            weight_decay=0.05,
        ),
        scheduler=dict(
            lr_scheduler_type="LambdaLinear",
            cycle_lengths=[100],  # smoke: 100 iters (real run sets via TOML)
            f_max=[0.4],
            f_min=[0.0],
            f_start=[0.0],
            verbosity_interval=0,
            warm_up_steps=[0],
        ),
        trainer=dict(
            distributed_parallelism="fsdp",
            grad_accum_iter=1,
            logging_iter=1,
            max_iter=100,  # smoke
            max_val_iter=None,
            run_validation=False,
            run_validation_on_start=False,
            save_zero_checkpoint=False,
            seed=42,
            timeout_period=999999999,
            validation_iter=100,
            compile_config=dict(recompile_limit=8, use_duck_shape=False),
            cudnn=dict(benchmark=True, deterministic=False),
            ddp=dict(broadcast_buffers=True, find_unused_parameters=False, static_graph=True),
            grad_scaler_args=dict(enabled=False),
            callbacks=dict(
                dataloader_speed=dict(every_n=100, save_s3=False, step_size=1),
                device_monitor=dict(
                    every_n=200, log_memory_detail=True, save_s3=False, step_size=1, upload_every_n_mul=5
                ),
                grad_clip=dict(clip_norm=1.0, force_finite=True),
                heart_beat=dict(every_n=200, save_s3=False, step_size=1, update_interval_in_minute=20),
                iter_speed=dict(every_n=1, hit_thres=50, save_s3=False, save_s3_every_log_n=500),
                low_precision=dict(update_iter=1),
                manual_gc=dict(every_n=5, gc_level=1, warm_up=1),
                param_count=dict(save_s3=False),
                skip_nan_step=dict(max_consecutive_nan=100),
                training_stats=dict(log_freq=100),
            ),
        ),
        checkpoint=dict(
            broadcast_via_filesystem=False,
            dcp_async_mode_enabled=False,
            enable_gcs_patch_in_boto3=True,
            keys_not_to_resume=[],
            # Init the action heads fresh from the base (Cosmos3-Nano's action heads
            # are not LIBERO-policy-trained), matching the DROID/PushT recipes.
            keys_to_skip_loading=[
                "net_ema.",
                "action2llm",
                "llm2action",
                "action_modality_embed",
                "action_pos_embed",
            ],
            load_ema_to_reg=False,
            load_path="???",  # Cosmos3-Nano DCP dir; supply via TOML/env
            load_training_state=False,
            only_load_scheduler_state=False,
            save_iter=100,
            strict_resume=False,  # base init: tolerate key set differences
            verbose=True,
            hf_export=dict(
                enabled=False,
                export_every_n=1,
                hf_repo_id=None,
                upload_to_object_store=dict(bucket="", credentials="", enabled=False),
            ),
            jit=dict(device="cuda", dtype="bfloat16", enabled=False, input_shape=None, strict=True),
            load_from_object_store=dict(bucket="", credentials="", enabled=False),
            save_to_object_store=dict(bucket="", credentials="", enabled=False),
        ),
        dataloader_train=L(PackingDataLoader)(
            audio_sample_rate=48000,
            dataset_name="action_libero",
            max_samples_per_batch=128,
            max_sequence_length=None,  # None disables token packing
            patch_spatial=2,
            sound_latent_fps=0,
            tokenizer_spatial_compression_factor=16,
            tokenizer_temporal_compression_factor=4,
            dataloader=L(RankPartitionedDataLoader)(
                batch_size=1,
                in_order=False,
                num_workers=4,
                persistent_workers=True,
                pin_memory=True,
                prefetch_factor=4,
                sampler=None,
                datasets=dict(
                    libero=dict(
                        ratio=1,
                        dataset=L(get_action_libero_sft_dataset)(
                            # Official LeRobot dataset (lerobot/libero): ONE combined
                            # repo (all suites, tasks via task_index) at fps=10, two
                            # cameras (image=agent, image2=wrist), action gripper already
                            # in env [-1,1] (no remap) and raw image orientation (no flip)
                            # — matches the official LiberoEnv eval, dropping our former
                            # LIBERO_LeRobot_v3 flip/gripper hacks.
                            root="${oc.env:LIBERO_ROOT}",
                            suites=None,  # single combined dataset (not per-suite dirs)
                            fps=10.0,
                            chunk_length=16,
                            mode="policy",
                            action_normalization="minmax",
                            normalization_path=(
                                "cosmos_framework/data/vfm/action/datasets/"
                                "lerobot_libero_normalization.json"
                            ),
                            viewpoint="third_person_view",
                            resolution="256",  # frames are 256x256 (~1:1)
                            max_action_dim="${model.config.max_action_dim}",
                            cfg_dropout_rate=0.1,
                            tokenizer_config="${model.config.vlm_config.tokenizer}",
                            # Prepend the current absolute proprio state[:7] as the
                            # conditioning action[0] (DROID/PushT use_state framing);
                            # action becomes (chunk+1, 7). The eval server must send
                            # the matching state and use --state-stats-key state.
                            use_state=True,
                            # Two-camera input: vertically concat agent-view (top) +
                            # wrist (bottom, the ``image2`` key) into one frame (Cosmos3
                            # single-input-video, DROID concat_view pattern).
                            use_wrist=True,
                            wrist_key="observation.images.image2",
                        ),
                    ),
                ),
            ),
        ),
        dataloader_val=None,
        upload_reproducible_setup=False,
    ),
    flags={"allow_objects": True},
)


# chunk_length=16 → 17 observation frames; pin the VAE encode duration to match
# (must be ≡1 mod 4 for the 4x temporal-compression tokenizer: 17 = 1 + 4*4).
action_policy_libero_nano["model"]["config"]["tokenizer"]["encode_exact_durations"] = [17]

# Slower power-EMA (rate 0.1 -> 0.2 = wider averaging window, beta@8k 0.999->0.9997)
# so the EMA weights average over the suite-competence oscillation instead of
# tracking whichever suite the latest iters favor.
action_policy_libero_nano["model"]["config"]["ema"]["rate"] = 0.2


for _item in [action_policy_libero_nano]:
    _name = [k for k, v in globals().items() if v is _item][0]
    cs.store(group="experiment", package="_global_", name=_name, node=_item)
